<style>
  #nav-icon-container {
    opacity: 0;
    translate: 0 -90%;
    pointer-events: none;
    transition: opacity 0.3s ease, translate 0.3s ease;
  }

  #nav-icon-container.visible {
    opacity: 1;
    translate: 0;
    pointer-events: auto;
  }
</style>

<script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
        window.addEventListener("scroll", () => {
            const svg = document.getElementById("hero-svg");
            const navIcon = document.getElementById("nav-icon-container");
            if (!svg || !navIcon) return;

            const rect = svg.getBoundingClientRect();

            // Trigger 100px later
            if (rect.top + rect.height < -100) {
                navIcon.classList.add("visible");
            } else {
                navIcon.classList.remove("visible");
            }
        });
    });
</script>