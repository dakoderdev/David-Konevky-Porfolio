---
import Image from "astro/components/Image.astro";
export interface Props {
  url: string;
  imageSrc: string;
}
const { url, imageSrc } = Astro.props;
const shortenedUrl = url.replace(/https?:\/\//, '').replace(/\/$/, '');
---
<a href={url}  data-aos="fade-up" data-aos-delay={100} class="flex flex-col items-center w-full rounded-xl overflow-hidden h-fit border border-secondary/10">
    <Image src={imageSrc} alt="Corralon Artesan" width={300} height={200} class="w-full object-cover" />
    <p class="text-secondary/90 text-xl font-semibold text-center p-2 pb-0"><slot /></p>
    <p class="text-secondary/50 text-xs -mt-1 pb-3 text-center">{shortenedUrl}</p>
</a>