---
import Image from "astro/components/Image.astro";
export interface Props {
  url: string;
  imageSrc: string;
  index: number;
}
const { url, imageSrc, index } = Astro.props;
const indexMod = index % 2 === 0 ? 0 : 1;
const shortenedUrl = url.replace(/https?:\/\//, '').replace(/\/$/, '');
---
<a href={url} data-aos="fade-up" data-aos-delay={indexMod * 100} class="group flex flex-col items-center w-full rounded-2xl sm:rounded-xl overflow-hidden h-fit bg-linear-to-r from-secondary/1 via-transparent to-secondary/1 border border-secondary/10">
    <Image src={imageSrc} alt="Corralon Artesan" width={300} height={200} class="relative w-full aspect-video object-top object-cover group-hover:opacity-80 transition-opacity duration-500" />
    <p class="text-secondary/90 text-xl font-semibold text-center p-2 pb-0"><slot /></p>
    <p class="text-secondary/50 text-xs -mt-1 pb-3 text-center">{shortenedUrl}</p>
</a>