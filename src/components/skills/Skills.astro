---
import SkillsCode from "./SkillsCode.astro";
import SkillIcon from "./SkillIcon.astro";
import Image from "astro/components/Image.astro";
---
<section data-aos="fade-up" data-aos-duration="700" id="habilidades" class="relative overflow-hidden text-secondary rounded-t-4xl px-4 pt-8 pb-16 md:p-14 min-h-screen 2xl:max-w-7xl mx-auto border-t border-secondary/10 h-fit">
    <div class="flex flex-col gap-4 items-center w-full">
        <article data-aos="flip-right" class="w-fit h-fit p-5 rounded-4xl bg-linear-215 from-primary/80 to-emerald-300/10 border border-secondary/10 shadow-[0.5px_-0.5px_0_0] shadow-secondary/20">
            <svg xmlns="http://www.w3.org/2000/svg" width="84" height="84" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M10 4v4"/><path d="M2 8h20"/><path d="M6 4v4"/></svg>
        </article>
        <h2 data-aos="fade-up" data-aos-duration="500" class="text-secondary text-4xl md:text-5xl text-center pb-6 font-semibold">Habilidades</h2>
        <div class="space-y-3 px-4 md:px-0">
            <ul class="grid md:grid-cols-2 mx-auto w-fit h-fit max-w-2xl gap-4">
                <li data-aos="fade-left" class="relative flex items-center max-md:max-w-xs flex-col min-[550px]:max-md:-translate-x-6 sm:flex-row gap-3 md:shadow-[0.5px_-0.5px_0_0] shadow-secondary/5 rounded-2xl text-secondary/80 w-full border py-4 px-6 border-secondary/10 bg-radial-[at_100%_-30%] from-50% from-emerald-900/3 to-emerald-300/5">
                    <Image src="/other-logos/utn.svg" alt="UTN Logo" class="size-14 sm:size-8 text-secondary opacity-80" width={32} height={32} />
                    <p class="text-center text-balance sm:text-start pb-2 sm:pb-0">Estudiante de la <b class="font-semibold">Universidad Tecnológica Nacional</b></p>
                </li>
                <li data-aos="fade-left" data-aos-delay={50} class="relative flex items-center max-md:max-w-xs flex-col min-[550px]:max-md:translate-x-6 sm:flex-row gap-3 md:shadow-[0.5px_-0.5px_0_0] shadow-secondary/5 rounded-2xl w-full text-secondary/80 border py-4 px-6 border-secondary/10 bg-radial-[at_100%_-30%] from-50% from-emerald-900/3 to-emerald-300/5">
                    <svg class="min-w-8 min-h-8 size-14 sm:size-8 aspect-square text-secondary opacity-80" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m10 9-3 3 3 3"/><path d="m14 15 3-3-3-3"/><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
                    <p class="text-center text-balance sm:text-start pb-2 sm:pb-0">Estudiando en la carrera de <b class="font-semibold">Programación</b> en Tucumán</p>
                </li>
            </ul>
            <p data-aos="fade-up" class="text-secondary/80 pt-6 pb-0 mx-auto text-base md:text-lg max-w-2xl text-pretty md:pb-6">
            Mi <b class="text-emerald-100/80">especialidad</b> es el desarrollo de aplicaciones web <b class="text-emerald-100/80">eficientes</b>, <b class="text-emerald-100/80">estéticas</b> y <b class="text-emerald-100/80">con un buen rendimiento</b>.
            Me esfuerzo por encontrar el equilibrio entre <b class="text-emerald-100/80">diseño</b>, <b class="text-emerald-100/80">funcionalidad</b> y <b class="text-emerald-100/80">usabilidad</b>, creando soluciones claras y orientadas a las necesidades reales de los usuarios y del cliente.
            Mi enfoque está en la <b class="text-emerald-100/80">calidad del código</b>, la <b class="text-emerald-100/80">escalabilidad de los proyectos</b> y <b class="text-emerald-100/80">crear un producto unico.</b>
            </p>
        </div>
        <div class="w-full flex pb-3 md:pb-6 flex-col">
           <SkillsCode />
        </div>
        <div class="w-full grid gap-y-8 md:grid-cols-2 content-start justify-center">
            <div class="md:border-r border-secondary/10">
                <h3 class="text-secondary/80 text-3xl pb-4 font-medium text-center">Lenguajes</h3>
                <div class="flex flex-wrap gap-3 justify-center">
                    {[
                        { name: "HTML", alt: "HTML logo", src: "/framework-logos/html.svg" },
                        { name: "CSS", alt: "CSS logo", src: "/framework-logos/css.svg" },
                        { name: "Javascript", alt: "Javascript logo", src: "/framework-logos/javascript.png" },
                        { name: "Typescript", alt: "Typescript logo", src: "/framework-logos/typescript.svg" },
                        { name: "C#", alt: "C# logo", src: "/framework-logos/c-sharp.png" },
                        { name: "Python", alt: "Python logo", src: "/framework-logos/python.webp" }
                    ].map((skill, idx) => (
                        <SkillIcon {...skill} key={idx} />
                    ))}
                </div>
            </div>
            <div>
                <h3 class="text-secondary/80 text-3xl pb-4 font-medium text-center">Frameworks</h3>
                <div class="flex flex-wrap gap-3 justify-center">
                    {[
                        { name: "React", alt: "React logo", src: "/framework-logos/react.svg" },
                        { name: "Next.js", alt: "Next.js logo", src: "/framework-logos/nextjs.jpeg" },
                        { name: "Astro", alt: "Astro logo", src: "/framework-logos/astro.png", extraRounded: true }
                    ].map((framework, idx) => (
                        <SkillIcon {...framework} key={idx} />
                    ))}
                </div>
            </div>
        </div>
    </div>
    <div class="absolute -top-24 left-1/2 md:left-3/4 -translate-1/2 w-1/2 h-1/2 -z-10 rounded-b-full blur-3xl bg-conic to-emerald-800/20 from-emerald-300/40"></div>
</section>

<style>
    pre {
        background: transparent !important;
        color: oklch(85% 0.02 260); 
        font-family: 'Fira Code', monospace;
        padding: 1rem;
        border-radius: 0.75rem;
        overflow-x: auto;
        }
</style>