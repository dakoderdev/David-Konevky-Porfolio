---
import Nav from "./Nav.astro"
---

<section class=" bg-primary px-8 pt-12 pb-12 2xl:max-w-7xl mx-auto">
  <Nav />
  <div
    class="flex flex-col mt-8 sm:flex-row gap-3 justify-between items-center"
    data-aos="fade-up"
    data-aos-duration="1600">
    <h3 class="flex text-secondary gap-3 text-xs font-medium items-center">
      <span class="border border-secondary/20 shadow-md shadow-secondary/5 rounded-full py-2 px-3">Front-end Developer</span>
      <span class="border border-secondary/20 shadow-md shadow-secondary/5 rounded-full py-2 px-3">UX/UI Designer</span>
      <span class="text-secondary/70 text-xs font-semibold">Disponible para trabajar</span>
    </h3> 
    <ul class="items-center inline-flex gap-3 relative">
      <li>
        <a href="https://github.com/michael-andreuzza" class="hover:text-secondary/80 text-secondary">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" height="16" width="16">
            <path d="M0 0h24v24H0z" fill="none"></path>
            <path d="M12 2C6.475 2 2 6.475 2 12a9.994 9.994 0 0 0 6.838 9.488c.5.087.687-.213.687-.476 0-.237-.013-1.024-.013-1.862-2.512.463-3.162-.612-3.362-1.175-.113-.288-.6-1.175-1.025-1.413-.35-.187-.85-.65-.013-.662.788-.013 1.35.725 1.538 1.025.9 1.512 2.338 1.087 2.912.825.088-.65.35-1.087.638-1.337-2.225-.25-4.55-1.113-4.55-4.938 0-1.088.387-1.987 1.025-2.688-.1-.25-.45-1.275.1-2.65 0 0 .837-.262 2.75 1.026a9.28 9.28 0 0 1 2.5-.338c.85 0 1.7.112 2.5.337 1.912-1.3 2.75-1.024 2.75-1.024.55 1.375.2 2.4.1 2.65.637.7 1.025 1.587 1.025 2.687 0 3.838-2.337 4.688-4.562 4.938.362.312.675.912.675 1.85 0 1.337-.013 2.412-.013 2.75 0 .262.188.574.688.474A10.016 10.016 0 0 0 22 12c0-5.525-4.475-10-10-10z" fill="currentColor"></path>
          </svg>
        </a>
      </li>
      <li>
        <a href="https://twitter.com/Mike_Andreuzza" class="hover:text-secondary/80 text-secondary">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" height="16" width="16">
            <path d="M0 0h24v24H0z" fill="none"></path>
            <path d="M15.3 5.55a2.9 2.9 0 0 0-2.9 2.847l-.028 1.575a.6.6 0 0 1-.68.583l-1.561-.212c-2.054-.28-4.022-1.226-5.91-2.799-.598 3.31.57 5.603 3.383 7.372l1.747 1.098a.6.6 0 0 1 .034.993L7.793 18.17c.947.059 1.846.017 2.592-.131 4.718-.942 7.855-4.492 7.855-10.348 0-.478-1.012-2.141-2.94-2.141zm-4.9 2.81a4.9 4.9 0 0 1 8.385-3.355c.711-.005 1.316.175 2.669-.645-.335 1.64-.5 2.352-1.214 3.331 0 7.642-4.697 11.358-9.463 12.309-3.268.652-8.02-.419-9.382-1.841.694-.054 3.514-.357 5.144-1.55C5.16 15.7-.329 12.47 3.278 3.786c1.693 1.977 3.41 3.323 5.15 4.037 1.158.475 1.442.465 1.973.538z" fill="currentColor"></path>
          </svg>
        </a>
      </li>
      <li>
        <a href="mailto:michael@andreuzza.com" class="hover:text-secondary/80 text-secondary">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" height="16" width="16">
            <path d="M0 0h24v24H0z" fill="none"></path>
            <path d="M3 3h18a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zm17 4.238l-7.928 7.1L4 7.216V19h16V7.238zM4.511 5l7.55 6.662L19.502 5H4.511z" fill="currentColor"></path>
          </svg>
        </a>
      </li>
    </ul>
  </div>
</section>
<section class="bg-primary px-8 pb-12 2xl:max-w-7xl mx-auto">
    <h1 data-aos="fade-up" data-aos-duration="1500" class="text-secondary/80 text-balance pb-8 w-full md:w-2/3 text-4xl font-semibold transition-colors duration-500">
      <b class="font-semibold text-secondary/95 underline underline-offset-4 decoration-secondary/10">Web Developer</b> especializado en Programación de 
      Tucumán, Argentina. Especializado en el desarrollo de 
      <b class="font-semibold text-secondary/95 underline underline-offset-4 decoration-secondary/10">paginas web únicas.</b> 
    </h1>
    <button data-aos="fade-up" data-aos-duration="1400" class="flex gap-2 py-3 pl-7 pr-6 items-center bg-gradient-to-br from-secondary to-secondary/60 cursor-pointer font-semibold rounded-full">
      Enviame un Email
      <svg xmlns="http://www.w3.org/2000/svg" class="opacity-80" width="18" height="18" stroke="currentColor" viewBox="0 0 24 24" fill="none" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail-icon lucide-mail"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg>
    </button>
</section>