---
import Nav from "./nav/Nav.astro";
---

<section class="px-4 md:px-8 pt-6 md:pt-12 pb-6 md:pb-2 2xl:max-w-7xl mx-auto">
  <Nav />
  <div
    class="flex w-full mt-3 md:mt-8 flex-wrap gap-3 justify-between items-center"
    data-aos="fade-up"
    data-aos-duration="1600">
    <h3 class="flex flex-wrap text-secondary gap-1.5 min-[525px]:gap-3 text-xs font-medium justify-center max-[525px]:grow min-[525px]:justify-baseline items-center">
      <span class="border border-secondary/20 shadow-md shadow-secondary/5 rounded-md min-[525px]:rounded-full py-1 px-2 min-[525px]:py-2 min-[525px]:px-3 text-nowrap">Front-end Developer</span>
      <span class="border border-secondary/20 shadow-md shadow-secondary/5 rounded-md min-[525px]:rounded-full py-1 px-2 min-[525px]:py-2 min-[525px]:px-3 text-nowrap">UX/UI Designer</span>
      <span class="text-secondary/70 text-xs font-semibold">Disponible para trabajar</span>
    </h3> 
    <ul class="items-center hidden min-[525px]:inline-flex gap-3 relative">
      <li class="inline-flex pr-4">
        <a href="https://github.com/dakoderdev" class="hover:text-secondary/60 text-secondary/80">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" height="20" width="20">
            <path d="M0 0h24v24H0z" fill="none"></path>
            <path d="M12 2C6.475 2 2 6.475 2 12a9.994 9.994 0 0 0 6.838 9.488c.5.087.687-.213.687-.476 0-.237-.013-1.024-.013-1.862-2.512.463-3.162-.612-3.362-1.175-.113-.288-.6-1.175-1.025-1.413-.35-.187-.85-.65-.013-.662.788-.013 1.35.725 1.538 1.025.9 1.512 2.338 1.087 2.912.825.088-.65.35-1.087.638-1.337-2.225-.25-4.55-1.113-4.55-4.938 0-1.088.387-1.987 1.025-2.688-.1-.25-.45-1.275.1-2.65 0 0 .837-.262 2.75 1.026a9.28 9.28 0 0 1 2.5-.338c.85 0 1.7.112 2.5.337 1.912-1.3 2.75-1.024 2.75-1.024.55 1.375.2 2.4.1 2.65.637.7 1.025 1.587 1.025 2.687 0 3.838-2.337 4.688-4.562 4.938.362.312.675.912.675 1.85 0 1.337-.013 2.412-.013 2.75 0 .262.188.574.688.474A10.016 10.016 0 0 0 22 12c0-5.525-4.475-10-10-10z" fill="currentColor"></path>
          </svg>
        </a>
      </li>
    </ul>
  </div>
</section>
<section class="px-4 md:px-8 pb-12 2xl:max-w-7xl flex flex-col justify-center mx-auto">
    <h1 data-aos="fade-up" data-aos-duration="1500" class="text-secondary/80 text-balance pb-8 w-full md:w-2/3 text-2xl min-[20rem]:text-3xl md:text-4xl font-semibold transition-colors duration-500">
      <b class="font-semibold text-secondary/95 underline underline-offset-4 decoration-secondary/10">Web Developer</b> especializado en Programación de 
      Tucumán, Argentina. Dedicado a el desarrollo de 
      <b class="font-semibold text-secondary/95 underline underline-offset-4 decoration-secondary/10">paginas web únicas.</b> 
    </h1>
    <div data-aos="fade-up" data-aos-duration="1400" class="flex flex-col items-stretch min-[25rem]:items-baseline min-[25rem]:flex-row flex-wrap gap-3">
      <a href="mailto:konevkydavid@gmail.com" class="dark flex gap-2 py-3 pl-6 pr-5 text-sm md:text-base justify-center items-center bg-linear-to-br from-secondary to-secondary/60 cursor-pointer font-semibold rounded-full hover:opacity-90 transition-opacity">
        Envíame un Email
        <svg xmlns="http://www.w3.org/2000/svg" class="opacity-80" width="18" height="18" stroke="currentColor" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg>
      </a>
      <a href="https://www.linkedin.com/in/david-konevky-93b657319/" class="flex gap-2 py-3 pl-5 pr-4 text-sm md:text-base justify-center items-center text-secondary/80 cursor-pointer font-semibold rounded-full hover:text-secondary hover:bg-secondary/10 transition-colors">
        Ver mi LinkedIn
        <svg xmlns="http://www.w3.org/2000/svg" class="opacity-80" width="18" height="18" stroke="currentColor" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </a>
    </div>
</section>